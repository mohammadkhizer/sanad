# ==============================================================================
# SANAD BACKEND API ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure your production or staging values.
# See inline comments below for links and steps to provision each service.
# ==============================================================================

# 1. SERVER & RUNTIME SETTINGS
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# 2. DATABASE CONFIGURATION (MONGODB ATLAS OR LOCAL)
# Free cluster: https://www.mongodb.com/cloud/atlas -> Create M0 Shared Cluster
MONGODB_URI=mongodb://localhost:27017/sanad

# 3. CACHE & RATE LIMITING (UPSTASH REDIS OR LOCAL)
# Free serverless Redis: https://upstash.com
REDIS_URL=redis://localhost:6379

# 4. CRYPTOGRAPHIC TOKEN SECRETS (JWT AUTHENTICATION)
# Generate via: openssl rand -hex 32
JWT_ACCESS_SECRET=development_access_secret_key_minimum_32_chars_long
JWT_REFRESH_SECRET=development_refresh_secret_key_minimum_32_chars_long

# 5. VIDEO STREAMING & REELS (MUX VIDEO)
# Access tokens: https://dashboard.mux.com -> Settings -> Access Tokens
MUX_TOKEN_ID=mock_mux_token_id
MUX_TOKEN_SECRET=mock_mux_token_secret

# 6. REALTIME VIDEO & AUDIO CALLS (LIVEKIT CLOUD)
# Free project: https://cloud.livekit.io -> Project Settings -> Keys
LIVEKIT_API_KEY=mock_livekit_key
LIVEKIT_API_SECRET=mock_livekit_secret
LIVEKIT_URL=https://livekit.example.com

# 7. DOCUMENT & CREDENTIAL STORAGE (CLOUDFLARE R2 OR AWS S3)
# S3-compatible bucket: https://dash.cloudflare.com -> R2 Object Storage
R2_ACCOUNT_ID=mock_r2_account
R2_ACCESS_KEY_ID=mock_r2_key
R2_SECRET_ACCESS_KEY=mock_r2_secret
R2_BUCKET_NAME=sanad-uploads

# 8. ADMINISTRATIVE SETUP
ADMIN_SIGNUP_SECRET=SanadAdminSetup2026!

# 9. TRANSACTIONAL EMAIL & PASSWORD RESET OTP (SMTP)
# Required for sending password recovery codes to user email addresses
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=noreply@sanad.app
SMTP_SECURE=false
