# ==============================================================================
# SANAD MOBILE & WEB CLIENT ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local or cloud build.
# NEVER store private secrets here; EXPO_PUBLIC_* variables are public by design.
# ==============================================================================

EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_DEFAULT_ROLE=admin

EXPO_PUBLIC_APP_NAME=Sanad
EXPO_PUBLIC_APP_TAGLINE=Verified-scholars-only social and learning platform
EXPO_PUBLIC_APP_URL=https://sanad.app

EXPO_PUBLIC_DEVELOPER_NAME=Mohammed Khizer Shaikh
EXPO_PUBLIC_DEVELOPER_PORTFOLIO=https://mohammedkhizershaikh.netlify.app
EXPO_PUBLIC_DEVELOPER_LINKEDIN=https://www.linkedin.com/in/mohammedkhizershaikh

EXPO_PUBLIC_SEO_TITLE=Sanad | Verified Scholars Knowledge & Learning Platform
EXPO_PUBLIC_SEO_DESCRIPTION=The authentic verified-scholars-only platform for classical Islamic sciences, isnad methodology, masterclasses, and halaqah circles.
EXPO_PUBLIC_SEO_KEYWORDS=Islamic scholarship, verified scholars, Hadith, Fiqh, Usul al-Fiqh, Isnad, Halaqah, traditional learning, Sanad

EXPO_PUBLIC_GEO_REGION=GLOBAL
EXPO_PUBLIC_GEO_PLACENAME=Global Islamic Scholarship Network
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_SUPPORTED_LOCALES=en,ar,ur
