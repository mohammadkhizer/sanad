{
  "name": "sanad-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sanad - Trusted Religious Scholar Publishing and Community Learning Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:types": "npm --workspace=@sanad/types run build",
    "build:api": "npm --workspace=@sanad/api run build",
    "build": "npm run build:types && npm run build:api",
    "test": "npm --workspace=@sanad/api run test",
    "dev:api": "npm --workspace=@sanad/api run dev",
    "dev:mobile": "npm --workspace=sanad-mobile start",
    "lint:api": "npm --workspace=@sanad/api run lint",
    "lint:mobile": "npm --workspace=sanad-mobile run lint"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}

