# ==============================================================================
# SANAD ROOT ENVIRONMENT CONFIGURATION REFERENCE
# ==============================================================================
# Sanad is an npm workspaces monorepo:
# - Backend API: apps/api/.env (MongoDB, Redis, JWT, Mux, Cloudflare R2)
# - Mobile & Web App: apps/mobile/.env (Expo SDK 58, API URL, Dev Attribution)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & PORTS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
METRO_PORT=8081

# ------------------------------------------------------------------------------
# 2. LEAD SOFTWARE ARCHITECT & DEVELOPER ATTRIBUTION
# ------------------------------------------------------------------------------
DEVELOPER_NAME=Mohammed Khizer Shaikh
DEVELOPER_PORTFOLIO=https://mohammedkhizershaikh.netlify.app
DEVELOPER_LINKEDIN=https://www.linkedin.com/in/mohammed-khizer-shaikh

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICES OVERVIEW (CONFIGURED IN apps/api/.env)
# ------------------------------------------------------------------------------
# MONGODB_URI: MongoDB Atlas M0 Free Cluster (https://cloud.mongodb.com)
# REDIS_URL: Upstash Redis Serverless Free Tier (https://upstash.com)
# JWT_ACCESS_SECRET: 32+ byte random hex string (openssl rand -hex 32)
# JWT_REFRESH_SECRET: 32+ byte random hex string (openssl rand -hex 32)
# MUX_TOKEN_ID / MUX_TOKEN_SECRET: Mux Video API Token (https://dashboard.mux.com)
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID: Cloudflare R2 Storage (https://dash.cloudflare.com)

# ------------------------------------------------------------------------------
# 4. MOBILE CLIENT OVERVIEW (CONFIGURED IN apps/mobile/.env)
# ------------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL: https://sanad-api-s8t5.onrender.com/api/v1 (or http://localhost:4000/api/v1)
# EXPO_PUBLIC_API_MODE: 'mock' (zero-cloud standalone) or 'http' (live backend)
# EXPO_PUBLIC_DEFAULT_ROLE: 'admin' (full CRUD unlocked)
